# Configuration template only: replace every example before deployment.
# Django does not load .env files automatically. Use your host secret manager.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/linguapath?sslmode=require
DJANGO_ALLOWED_HOSTS=linguapath.YOUR_SUBDOMAIN.workers.dev
DJANGO_CSRF_TRUSTED_ORIGINS=https://linguapath.YOUR_SUBDOMAIN.workers.dev
# Enable only behind the supplied Worker, which overwrites this header.
DJANGO_TRUST_PROXY_SSL_HEADER=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Begin with 0 while verifying HTTPS, then increase (e.g. 31536000).
DJANGO_SECURE_HSTS_SECONDS=0
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=60
# No paid model calls on initial deployment; local content lookup still works.
AI_TUTOR_ENABLED=false
AI_TUTOR_PROVIDER=cloudflare
CLOUDFLARE_AI_ENDPOINT=https://linguapath.YOUR_SUBDOMAIN.workers.dev/internal/tutor/infer
# Set through `wrangler secret put AI_BRIDGE_SECRET`, never put the value in vars.
# The Worker passes the SAME secret into its Django container.
AI_BRIDGE_SECRET=REPLACE_WITH_32_TO_256_RANDOM_ASCII_CHARACTERS
AI_TUTOR_DAILY_LIMIT=20
AI_TUTOR_MINUTE_LIMIT=3
# Global limits below apply to the Worker Durable Object, not Django itself.
AI_TUTOR_GLOBAL_DAILY_LIMIT=200
AI_TUTOR_GLOBAL_MINUTE_LIMIT=20
# Leave unset until the Worker/container peer address is verified on staging.
# Trust only actual direct-peer CIDRs; never allow all addresses.
# DJANGO_AUTH_TRUSTED_PROXIES=
# Recommended only with the sanitized header from this project's Worker:
# DJANGO_AUTH_CLIENT_IP_HEADER=HTTP_X_LINGUAPATH_CLIENT_IP
