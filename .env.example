DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For production, set DJANGO_DEBUG=false, use a random DJANGO_SECRET_KEY of at
# least 50 characters, and set DJANGO_ALLOWED_HOSTS to your real host names.
# HTTPS security defaults are enabled when DEBUG is false. Set these explicitly
# only when your trusted proxy/deployment requires a different arrangement.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# Production defaults to one year of HSTS. Override with 0 during initial
# HTTPS verification; then increase once the proxy and domain are confirmed.
# DJANGO_SECURE_HSTS_SECONDS=0
# DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/linguapath?sslmode=require
# PostgreSQL connection setup defaults to 5 seconds per host; allowed range 1–30.
# DJANGO_DB_CONNECT_TIMEOUT=5
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Set true only behind an ingress that replaces X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_SSL_HEADER=true
# Optional: add this only when you have an API key and want external model explanations.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# AI_TUTOR_ENABLED=true
# AI_TUTOR_DAILY_LIMIT=20
# AI_TUTOR_MINUTE_LIMIT=3
# AI_TUTOR_GLOBAL_DAILY_LIMIT=200
# AI_TUTOR_GLOBAL_MINUTE_LIMIT=20
# Optional Workers AI instead of OpenAI. Endpoint must use HTTPS and an exact
# DJANGO_ALLOWED_HOSTS entry, with the path /internal/tutor/infer.
# AI_TUTOR_PROVIDER=cloudflare
# CLOUDFLARE_AI_ENDPOINT=https://your-domain.example/internal/tutor/infer
# AI_BRIDGE_SECRET=
# Auth quotas use REMOTE_ADDR by default. Forwarded IPs require an explicit
# allowlist of verified direct proxy CIDRs, especially behind Cloudflare.
# DJANGO_AUTH_TRUSTED_PROXIES=
# DJANGO_AUTH_CLIENT_IP_HEADER=HTTP_X_LINGUAPATH_CLIENT_IP
